{
  "name": "notch",
  "productName": "Notch",
  "version": "0.1.0",
  "description": "AI-ready Dynamic Island style utility for Windows",
  "author": "Kumar Ojaswi",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/meojaswi/Notch.git"
  },
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "pack": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "electron-log": "^5.4.4",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
