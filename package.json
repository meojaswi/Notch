{
  "name": "notch",
  "version": "0.1.0",
  "description": "AI-ready Dynamic Island style utility for Windows",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "dist": "npm run build && cross-env NODE_ENV=production electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "dotenv": "^17.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.4.10",
    "wait-on": "^8.0.0"
  }
}
